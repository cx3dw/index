    <!-- =====================================================================
         LÓGICA INTERACTIVA EN JAVASCRIPT (ESPAÑOL)
    ====================================================================== -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Actualizar año automáticamente en el footer
            const yearSpan = document.getElementById('current-year');
            if (yearSpan) {
                yearSpan.textContent = new Date().getFullYear();
            }

            // 2. Control del Menú Móvil
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileMenuIcon = document.getElementById('mobile-menu-icon');
            const mobileLinks = document.querySelectorAll('.mobile-link');

            function toggleMobileMenu() {
                const isHidden = mobileMenu.classList.contains('hidden');
                if (isHidden) {
                    mobileMenu.classList.remove('hidden');
                    mobileMenuIcon.classList.remove('fa-bars');
                    mobileMenuIcon.classList.add('fa-xmark');
                } else {
                    mobileMenu.classList.add('hidden');
                    mobileMenuIcon.classList.remove('fa-xmark');
                    mobileMenuIcon.classList.add('fa-bars');
                }
            }

            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', toggleMobileMenu);
            }

            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                    mobileMenuIcon.classList.remove('fa-xmark');
                    mobileMenuIcon.classList.add('fa-bars');
                });
            });

            // 3. Pre-seleccionar servicio en el formulario al hacer clic en las tarjetas
            const serviceButtons = document.querySelectorAll('.solicitar-servicio');
            const serviceSelect = document.getElementById('servicio');

            serviceButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const selectedService = btn.getAttribute('data-servicio');
                    if (serviceSelect && selectedService) {
                        serviceSelect.value = selectedService;
                    }
                });
            });

            // 4. Validación y Envío Interactivo del Formulario de Presupuesto
            const quoteForm = document.getElementById('quote-form');
            const successBox = document.getElementById('form-success-box');
            const successSummary = document.getElementById('success-summary');
            const whatsappForwardBtn = document.getElementById('whatsapp-forward-btn');
            const resetFormBtn = document.getElementById('reset-form-btn');

            if (quoteForm) {
                quoteForm.addEventListener('submit', (e) => {
                    e.preventDefault();

                    // Obtener valores
                    const nombre = document.getElementById('nombre').value.trim();
                    const telefono = document.getElementById('telefono').value.trim();
                    const vehiculo = document.getElementById('vehiculo').value.trim();
                    const servicio = document.getElementById('servicio').value;
                    const detalle = document.getElementById('detalle').value.trim();

                    // Referencias de errores
                    const errNombre = document.getElementById('error-nombre');
                    const errTelefono = document.getElementById('error-telefono');
                    const errVehiculo = document.getElementById('error-vehiculo');
                    const errDetalle = document.getElementById('error-detalle');

                    let isValid = true;

                    // Validar Nombre
                    if (nombre.length < 2) {
                        errNombre.classList.remove('hidden');
                        isValid = false;
                    } else {
                        errNombre.classList.add('hidden');
                    }

                    // Validar Teléfono
                    if (telefono.length < 6) {
                        errTelefono.classList.remove('hidden');
                        isValid = false;
                    } else {
                        errTelefono.classList.add('hidden');
                    }

                    // Validar Vehículo
                    if (vehiculo.length < 2) {
                        errVehiculo.classList.remove('hidden');
                        isValid = false;
                    } else {
                        errVehiculo.classList.add('hidden');
                    }

                    // Validar Detalle
                    if (detalle.length < 4) {
                        errDetalle.classList.remove('hidden');
                        isValid = false;
                    } else {
                        errDetalle.classList.add('hidden');
                    }

                    if (!isValid) return;

                    // Mostrar confirmación visual personalizada
                    successSummary.innerHTML = `
                        Gracias <strong>${nombre}</strong>. Registramos tu solicitud para tu <strong>${vehiculo}</strong> (${servicio}). Nos comunicaremos al <strong>${telefono}</strong> a la brevedad.
                    `;

                    // Preparar enlace directo de WhatsApp con los datos cargados
                    const mensajeWa = `Hola Gustavo, solicito turno/presupuesto:%0A• *Nombre:* ${encodeURIComponent(nombre)}%0A• *Vehículo:* ${encodeURIComponent(vehiculo)}%0A• *Servicio:* ${encodeURIComponent(servicio)}%0A• *Detalle:* ${encodeURIComponent(detalle)}`;
                    whatsappForwardBtn.href = `https://wa.me/59894586969?text=${mensajeWa}`;

                    // Alternar vista de formulario a confirmación
                    quoteForm.classList.add('hidden');
                    successBox.classList.remove('hidden');
                });
            }

            // Botón para reiniciar el formulario
            if (resetFormBtn) {
                resetFormBtn.addEventListener('click', () => {
                    quoteForm.reset();
                    successBox.classList.add('hidden');
                    quoteForm.classList.remove('hidden');
                });
            }

            // =================================================================
            // 5. GESTIÓN DINÁMICA DE PROMOCIONES ESPECIALES (localStorage)
            // =================================================================
            // 5. SISTEMA DE SEGURIDAD Y MODO ADMINISTRADOR PRIVADO
            // =================================================================
            const STORAGE_KEY_PROMOS = 'gustavo_electricidad_promociones_v1';
            const STORAGE_KEY_ADMIN_PIN = 'gustavo_electricidad_admin_pin_v1';
            const SESSION_KEY_AUTH = 'gustavo_electricidad_admin_session_v1';
            const DEFAULT_ADMIN_PIN = '1688';

            // Promociones iniciales por defecto (estas son las que se actualizan si exportás el HTML)
            const defaultPromos = [
                {
                    id: 'promo-1',
                    titulo: 'Diagnóstico Computarizado + Control de Carga',
                    precio: '20% OFF',
                    vigencia: 'Promoción Destacada',
                    descripcion: 'Escaneo electrónico multimarca completo, lectura de fallas en tablero y testeo digital de batería y alternador.'
                },
                {
                    id: 'promo-2',
                    titulo: 'Service Preventivo de Arranque y Alternador',
                    precio: '15% OFF en Mano de Obra',
                    vigencia: 'Válido este mes',
                    descripcion: 'Desarme, limpieza técnica, control de carbones, colector, rulemanes y prueba de rendimiento en banco.'
                },
                {
                    id: 'promo-3',
                    titulo: 'Instalación Profesional de Kit Cree LED',
                    precio: 'Chequeo Eléctrico Sin Cargo',
                    vigencia: 'Cupos limitados',
                    descripcion: 'Colocación prolija con alineación de haz de luz y revisión completa de fusibleras y relés de iluminación.'
                }
            ];

            let promociones = [];

            function getAdminPin() {
                try {
                    return localStorage.getItem(STORAGE_KEY_ADMIN_PIN) || DEFAULT_ADMIN_PIN;
                } catch (e) {
                    return DEFAULT_ADMIN_PIN;
                }
            }

            function setAdminPin(newPin) {
                try {
                    localStorage.setItem(STORAGE_KEY_ADMIN_PIN, newPin);
                } catch (e) {
                    console.error('No se pudo guardar la clave:', e);
                }
            }

            function isAdminAuthenticated() {
                try {
                    return sessionStorage.getItem(SESSION_KEY_AUTH) === 'true';
                } catch (e) {
                    return false;
                }
            }

            function setAdminSession(active) {
                try {
                    if (active) {
                        sessionStorage.setItem(SESSION_KEY_AUTH, 'true');
                    } else {
                        sessionStorage.removeItem(SESSION_KEY_AUTH);
                    }
                } catch (e) {
                    console.error('Error en sesión de administrador:', e);
                }
            }

            function loadPromos() {
                try {
                    const saved = localStorage.getItem(STORAGE_KEY_PROMOS);
                    if (saved) {
                        const parsed = JSON.parse(saved);
                        if (Array.isArray(parsed)) {
                            promociones = parsed;
                            return;
                        }
                    }
                } catch (err) {
                    console.error('Error leyendo promociones:', err);
                }
                promociones = [...defaultPromos];
                savePromos();
            }

            function savePromos() {
                try {
                    localStorage.setItem(STORAGE_KEY_PROMOS, JSON.stringify(promociones));
                } catch (err) {
                    console.error('Error guardando promociones:', err);
                }
            }

            // Referencias del DOM para Promociones y Administración
            const promosGrid = document.getElementById('promociones-grid');
            const adminStatusBar = document.getElementById('admin-status-bar');
            const adminPromoHeaderActions = document.getElementById('admin-promo-header-actions');
            const openNewPromoBtn = document.getElementById('open-new-promo-btn');
            const barNewPromoBtn = document.getElementById('bar-new-promo-btn');
            const barChangePinBtn = document.getElementById('bar-change-pin-btn');
            const barLogoutBtn = document.getElementById('bar-logout-btn');

            const closePromoAdminBtn = document.getElementById('close-promo-admin-btn');
            const promoAdminPanel = document.getElementById('promo-admin-panel');
            const promoAdminForm = document.getElementById('promo-admin-form');
            const promoEditIdInput = document.getElementById('promo-edit-id');
            const promoTituloInput = document.getElementById('promo-titulo');
            const promoPrecioInput = document.getElementById('promo-precio');
            const promoVigenciaInput = document.getElementById('promo-vigencia');
            const promoDescripcionInput = document.getElementById('promo-descripcion');
            const promoFormTitle = document.getElementById('promo-form-title');
            const promoSubmitText = document.getElementById('promo-submit-text');
            const cancelEditPromoBtn = document.getElementById('cancel-edit-promo-btn');

            // Referencias Modales Login y Cambio de Clave
            const openAdminLoginBtn = document.getElementById('open-admin-login-btn');
            const adminLoginModal = document.getElementById('admin-login-modal');
            const closeLoginModalBtn = document.getElementById('close-login-modal-btn');
            const adminLoginForm = document.getElementById('admin-login-form');
            const adminPinInput = document.getElementById('admin-pin-input');
            const adminLoginError = document.getElementById('admin-login-error');

            const adminChangePinModal = document.getElementById('admin-change-pin-modal');
            const closeChangePinModalBtn = document.getElementById('close-change-pin-modal-btn');
            const adminChangePinForm = document.getElementById('admin-change-pin-form');
            const newPinInput = document.getElementById('new-pin-input');
            const confirmPinInput = document.getElementById('confirm-pin-input');
            const changePinFeedback = document.getElementById('change-pin-feedback');

            // Botones de Exportación / Copiado
            const exportHtmlBtn = document.getElementById('export-html-btn');
            const copyPromosCodeBtn = document.getElementById('copy-promos-code-btn');
            const exportFeedbackMsg = document.getElementById('export-feedback-msg');

            function escapeHTML(str) {
                const div = document.createElement('div');
                div.textContent = str;
                return div.innerHTML;
            }

            function renderPromos() {
                if (!promosGrid) return;
                const isAdmin = isAdminAuthenticated();

                if (promociones.length === 0) {
                    promosGrid.innerHTML = `
                        <div class="col-span-full text-center py-12 bg-brand-navyCard/60 border border-slate-700/70 rounded-3xl p-8">
                            <i class="fa-solid fa-tag text-3xl text-brand-goldBright mb-3"></i>
                            <p class="text-brand-silver text-base">No hay promociones activas en este momento.</p>
                            ${isAdmin ? '<p class="text-xs text-brand-silverDark mt-1">Usá el botón "+ Nueva Promoción" para publicar una nueva oferta.</p>' : ''}
                        </div>
                    `;
                    return;
                }

                promosGrid.innerHTML = promociones.map(promo => {
                    const waText = encodeURIComponent(`Hola Gustavo, me interesa la promoción: "${promo.titulo}" (${promo.precio}). Quisiera consultar disponibilidad.`);
                    
                    // Controles de Editar y Eliminar: SOLO se renderizan si el administrador inició sesión
                    const adminControls = isAdmin ? `
                        <div class="flex items-center justify-end gap-2 pt-3 mt-3 border-t border-slate-700/70">
                            <button type="button" data-action="edit" data-id="${escapeHTML(promo.id)}" class="px-3 py-1.5 rounded-lg bg-brand-navyLight hover:bg-slate-700 text-brand-silverLight text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer">
                                <i class="fa-solid fa-pen text-brand-goldBright"></i> Editar
                            </button>
                            <button type="button" data-action="delete" data-id="${escapeHTML(promo.id)}" class="px-3 py-1.5 rounded-lg bg-red-950/70 hover:bg-red-900 text-red-300 text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer">
                                <i class="fa-solid fa-trash"></i> Eliminar
                            </button>
                        </div>
                    ` : '';

                    return `
                        <article class="relative bg-gradient-to-b from-brand-navyLight/95 to-brand-navyCard border-2 border-brand-gold/45 hover:border-brand-goldBright rounded-3xl p-7 shadow-navy-depth flex flex-col justify-between transition-all duration-300 hover:-translate-y-1">
                            <div>
                                <!-- Etiqueta Superior de Vigencia -->
                                <div class="flex items-center justify-between gap-2 mb-4">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-gold/20 border border-brand-gold/40 text-brand-goldBright text-xs font-bold">
                                        <i class="fa-solid fa-bolt text-[10px]"></i>
                                        ${escapeHTML(promo.vigencia)}
                                    </span>
                                    <span class="text-brand-goldBright/80 text-lg">
                                        <i class="fa-solid fa-percent"></i>
                                    </span>
                                </div>

                                <!-- Título y Precio/Descuento -->
                                <h3 class="font-display font-bold text-xl text-white mb-2 leading-snug">
                                    ${escapeHTML(promo.titulo)}
                                </h3>
                                <div class="inline-block my-2 px-3.5 py-1.5 rounded-xl bg-brand-navyDark border border-brand-gold/50">
                                    <span class="font-display font-black text-lg sm:text-xl text-brand-goldBright">
                                        ${escapeHTML(promo.precio)}
                                    </span>
                                </div>

                                <!-- Descripción -->
                                <p class="text-brand-silver text-sm leading-relaxed mt-3 mb-6">
                                    ${escapeHTML(promo.descripcion)}
                                </p>
                            </div>

                            <div>
                                <a href="https://wa.me/59894586969?text=${waText}" target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-2 bg-gold-gradient hover:brightness-110 text-brand-navyDark font-extrabold text-sm py-3.5 px-4 rounded-xl shadow-gold-glow transition-all">
                                    <i class="fa-brands fa-whatsapp text-lg"></i>
                                    <span>Consultar Promoción</span>
                                </a>
                                ${adminControls}
                            </div>
                        </article>
                    `;
                }).join('');
            }

            function resetPromoAdminForm() {
                if (!promoAdminForm) return;
                promoAdminForm.reset();
                promoEditIdInput.value = '';
                promoFormTitle.textContent = 'Agregar Nueva Promoción';
                promoSubmitText.textContent = 'Guardar Promoción';
                cancelEditPromoBtn.classList.add('hidden');
            }

            function openPromoFormPanel() {
                if (!isAdminAuthenticated()) return;
                promoAdminPanel.classList.remove('hidden');
                promoAdminPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            function updateAdminUIState() {
                const isAdmin = isAdminAuthenticated();
                if (isAdmin) {
                    adminStatusBar.classList.remove('hidden');
                    adminPromoHeaderActions.classList.remove('hidden');
                } else {
                    adminStatusBar.classList.add('hidden');
                    adminPromoHeaderActions.classList.add('hidden');
                    promoAdminPanel.classList.add('hidden');
                    resetPromoAdminForm();
                }
                renderPromos();
            }

            // Abrir Modal de Login
            function openLoginModal() {
                if (isAdminAuthenticated()) {
                    openPromoFormPanel();
                    return;
                }
                adminLoginError.classList.add('hidden');
                adminLoginForm.reset();
                adminLoginModal.classList.remove('hidden');
                setTimeout(() => adminPinInput.focus(), 50);
            }

            if (openAdminLoginBtn) {
                openAdminLoginBtn.addEventListener('click', openLoginModal);
            }

            // Atajo de teclado Ctrl + Shift + A para abrir acceso de administrador
            document.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.shiftKey && (e.key === 'A' || e.key === 'a')) {
                    e.preventDefault();
                    openLoginModal();
                }
            });

            if (closeLoginModalBtn) {
                closeLoginModalBtn.addEventListener('click', () => {
                    adminLoginModal.classList.add('hidden');
                });
            }

            if (adminLoginModal) {
                adminLoginModal.addEventListener('click', (e) => {
                    if (e.target === adminLoginModal) {
                        adminLoginModal.classList.add('hidden');
                    }
                });
            }

            // Validar Contraseña / PIN
            if (adminLoginForm) {
                adminLoginForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const enteredPin = adminPinInput.value.trim();
                    const currentPin = getAdminPin();

                    if (enteredPin === currentPin) {
                        setAdminSession(true);
                        adminLoginModal.classList.add('hidden');
                        adminLoginForm.reset();
                        updateAdminUIState();
                        openPromoFormPanel();
                    } else {
                        adminLoginError.classList.remove('hidden');
                        adminPinInput.select();
                    }
                });
            }

            // Cerrar Sesión de Administrador
            if (barLogoutBtn) {
                barLogoutBtn.addEventListener('click', () => {
                    setAdminSession(false);
                    updateAdminUIState();
                });
            }

            // Abrir formulario desde botones de administrador
            if (openNewPromoBtn) {
                openNewPromoBtn.addEventListener('click', () => {
                    resetPromoAdminForm();
                    openPromoFormPanel();
                });
            }

            if (barNewPromoBtn) {
                barNewPromoBtn.addEventListener('click', () => {
                    resetPromoAdminForm();
                    openPromoFormPanel();
                });
            }

            if (closePromoAdminBtn) {
                closePromoAdminBtn.addEventListener('click', () => {
                    promoAdminPanel.classList.add('hidden');
                    resetPromoAdminForm();
                });
            }

            if (cancelEditPromoBtn) {
                cancelEditPromoBtn.addEventListener('click', resetPromoAdminForm);
            }

            // Guardar o Actualizar Promoción (verificando sesión activa)
            if (promoAdminForm) {
                promoAdminForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    if (!isAdminAuthenticated()) return;

                    const titulo = promoTituloInput.value.trim();
                    const precio = promoPrecioInput.value.trim();
                    const vigencia = promoVigenciaInput.value.trim();
                    const descripcion = promoDescripcionInput.value.trim();
                    const editId = promoEditIdInput.value;

                    if (!titulo || !precio || !vigencia || !descripcion) return;

                    if (editId) {
                        const idx = promociones.findIndex(p => p.id === editId);
                        if (idx !== -1) {
                            promociones[idx] = { id: editId, titulo, precio, vigencia, descripcion };
                        }
                    } else {
                        promociones.unshift({
                            id: 'promo-' + Date.now(),
                            titulo,
                            precio,
                            vigencia,
                            descripcion
                        });
                    }

                    savePromos();
                    resetPromoAdminForm();
                    renderPromos();
                });
            }

            // Editar / Eliminar tarjetas (solo si hay sesión de administrador)
            if (promosGrid) {
                promosGrid.addEventListener('click', (e) => {
                    if (!isAdminAuthenticated()) return;

                    const btn = e.target.closest('button[data-action]');
                    if (!btn) return;

                    const action = btn.getAttribute('data-action');
                    const id = btn.getAttribute('data-id');

                    if (action === 'delete') {
                        promociones = promociones.filter(p => p.id !== id);
                        if (promoEditIdInput.value === id) {
                            resetPromoAdminForm();
                        }
                        savePromos();
                        renderPromos();
                    } else if (action === 'edit') {
                        const promo = promociones.find(p => p.id === id);
                        if (!promo) return;
                        promoEditIdInput.value = promo.id;
                        promoTituloInput.value = promo.titulo;
                        promoPrecioInput.value = promo.precio;
                        promoVigenciaInput.value = promo.vigencia;
                        promoDescripcionInput.value = promo.descripcion;
                        promoFormTitle.textContent = 'Editar Promoción';
                        promoSubmitText.textContent = 'Actualizar Promoción';
                        cancelEditPromoBtn.classList.remove('hidden');
                        openPromoFormPanel();
                    }
                });
            }

            // Modal Cambiar Clave
            if (barChangePinBtn) {
                barChangePinBtn.addEventListener('click', () => {
                    if (!isAdminAuthenticated()) return;
                    changePinFeedback.classList.add('hidden');
                    adminChangePinForm.reset();
                    adminChangePinModal.classList.remove('hidden');
                    setTimeout(() => newPinInput.focus(), 50);
                });
            }

            if (closeChangePinModalBtn) {
                closeChangePinModalBtn.addEventListener('click', () => {
                    adminChangePinModal.classList.add('hidden');
                });
            }

            if (adminChangePinModal) {
                adminChangePinModal.addEventListener('click', (e) => {
                    if (e.target === adminChangePinModal) {
                        adminChangePinModal.classList.add('hidden');
                    }
                });
            }

            if (adminChangePinForm) {
                adminChangePinForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    if (!isAdminAuthenticated()) return;

                    const newPin = newPinInput.value.trim();
                    const confirmPin = confirmPinInput.value.trim();

                    if (newPin.length < 4) {
                        changePinFeedback.textContent = 'La nueva clave debe tener al menos 4 caracteres.';
                        changePinFeedback.className = 'text-xs mt-1.5 font-medium text-red-400';
                        changePinFeedback.classList.remove('hidden');
                        return;
                    }

                    if (newPin !== confirmPin) {
                        changePinFeedback.textContent = 'Las claves no coinciden. Verificá nuevamente.';
                        changePinFeedback.className = 'text-xs mt-1.5 font-medium text-red-400';
                        changePinFeedback.classList.remove('hidden');
                        return;
                    }

                    setAdminPin(newPin);
                    changePinFeedback.textContent = '¡Clave actualizada con éxito!';
                    changePinFeedback.className = 'text-xs mt-1.5 font-medium text-emerald-400';
                    changePinFeedback.classList.remove('hidden');

                    setTimeout(() => {
                        adminChangePinModal.classList.add('hidden');
                    }, 1100);
                });
            }

            // Herramientas de Exportación / Copiado de Promociones para Hosting
            function showExportFeedback(message) {
                if (!exportFeedbackMsg) return;
                exportFeedbackMsg.textContent = message;
                exportFeedbackMsg.classList.remove('hidden');
                setTimeout(() => {
                    exportFeedbackMsg.classList.add('hidden');
                }, 5000);
            }

            if (copyPromosCodeBtn) {
                copyPromosCodeBtn.addEventListener('click', () => {
                    if (!isAdminAuthenticated()) return;
                    const codeSnippet = `const defaultPromos = ${JSON.stringify(promociones, null, 4)};`;
                    const tempTextarea = document.createElement('textarea');
                    tempTextarea.value = codeSnippet;
                    tempTextarea.style.position = 'fixed';
                    tempTextarea.style.left = '-9999px';
                    document.body.appendChild(tempTextarea);
                    tempTextarea.select();
                    try {
                        document.execCommand('copy');
                        showExportFeedback('¡Código de promociones copiado al portapapeles! Podés pegarlo reemplazando "defaultPromos" en tu archivo index.html.');
                    } catch (err) {
                        showExportFeedback('No se pudo copiar automáticamente. Usá la opción "Descargar HTML Actualizado".');
                    }
                    document.body.removeChild(tempTextarea);
                });
            }

            if (exportHtmlBtn) {
                exportHtmlBtn.addEventListener('click', () => {
                    if (!isAdminAuthenticated()) return;
                    try {
                        // Obtener el HTML completo actual y reemplazar el arreglo defaultPromos con las promociones vigentes
                        const rawHtml = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
                        const updatedPromosBlock = `const defaultPromos = ${JSON.stringify(promociones, null, 16)};`;
                        const finalHtml = rawHtml.replace(/const defaultPromos = \[[\s\S]*?\];/, updatedPromosBlock);

                        const blob = new Blob([finalHtml], { type: 'text/html;charset=utf-8' });
                        const url = URL.createObjectURL(blob);
                        const downloadLink = document.createElement('a');
                        downloadLink.href = url;
                        downloadLink.download = 'index.html';
                        document.body.appendChild(downloadLink);
                        downloadLink.click();
                        document.body.removeChild(downloadLink);
                        URL.revokeObjectURL(url);

                        showExportFeedback('¡Archivo "index.html" descargado con tus promociones actualizadas! Subilo a tu hosting para que todos los visitantes las vean.');
                    } catch (err) {
                        console.error('Error exportando HTML:', err);
                        showExportFeedback('Ocurrió un error al generar el archivo HTML.');
                    }
                });
            }

            // Inicializar promociones y verificar estado de sesión al cargar
            loadPromos();
            updateAdminUIState();
        });
    </script>
</body>
</html>
